#!/usr/bin/env python3
"""Wire Agent Board into Claude Code, Cursor and Codex (or unwire it).

  agent-board-setup install     add hooks (backs up each config first, safe to re-run)
  agent-board-setup uninstall   remove only Agent Board's hooks, restore Codex's notify
"""
import json
import os
import re
import shutil
import sys
import time

HOME = os.path.expanduser("~")
BOARD = os.path.join(HOME, ".agent-board")
EVENT = os.path.join(BOARD, "bin", "agent-board-event")
NOTIFY = os.path.join(BOARD, "bin", "codex-notify")
PREV_NOTIFY = os.path.join(BOARD, "codex-previous-notify.json")
MARK = "agent-board-event"
STAMP = time.strftime("%Y%m%d-%H%M%S")


def backup(path):
    if os.path.exists(path):
        shutil.copy2(path, f"{path}.agent-board-bak-{STAMP}")


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


# ---------------- Claude Code: ~/.claude/settings.json ----------------

CLAUDE_HOOKS = {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": f"{EVENT} claude start"}]}],
    "Stop": [{"hooks": [{"type": "command", "command": f"{EVENT} claude done"}]}],
    "Notification": [{"matcher": "permission_prompt|elicitation_dialog",
                      "hooks": [{"type": "command", "command": f"{EVENT} claude waiting"}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": f"{EVENT} claude resume", "async": True}]}],
}


def strip_ours(groups):
    """Drop hook groups that only run Agent Board; keep everything the user had."""
    kept = []
    for g in groups or []:
        hooks = [h for h in g.get("hooks", []) if MARK not in h.get("command", "")]
        if hooks:
            kept.append(dict(g, hooks=hooks))
    return kept


def claude(install):
    path = os.path.join(HOME, ".claude", "settings.json")
    if not os.path.isdir(os.path.dirname(path)):
        return "Claude Code: not found, skipped"
    settings = load_json(path, {})
    backup(path)
    hooks = settings.get("hooks", {})
    for event in CLAUDE_HOOKS:
        hooks[event] = strip_ours(hooks.get(event))
        if install:
            hooks[event] += CLAUDE_HOOKS[event]
        if not hooks[event]:
            hooks.pop(event)
    settings["hooks"] = hooks
    if not hooks:
        settings.pop("hooks")
    save_json(path, settings)
    return "Claude Code: hooks " + ("added" if install else "removed")


# ---------------- Cursor: ~/.cursor/hooks.json ----------------

def cursor(install):
    root = os.path.join(HOME, ".cursor")
    if not os.path.isdir(root):
        return "Cursor: not found, skipped"
    path = os.path.join(root, "hooks.json")
    cfg = load_json(path, {"version": 1, "hooks": {}})
    backup(path)
    hooks = cfg.setdefault("hooks", {})
    for event, arg in (("beforeSubmitPrompt", "start"), ("stop", "done")):
        hooks[event] = [h for h in hooks.get(event, []) if MARK not in h.get("command", "")]
        if install:
            hooks[event].append({"command": f"{EVENT} cursor {arg}"})
        if not hooks[event]:
            hooks.pop(event)
    cfg.setdefault("version", 1)
    save_json(path, cfg)
    return "Cursor: hooks " + ("added" if install else "removed")


# ---------------- Codex: ~/.codex/config.toml `notify` ----------------

NOTIFY_LINE = re.compile(r"^notify\s*=\s*\[.*?\]\s*\n", re.S | re.M)


def codex(install):
    path = os.path.join(HOME, ".codex", "config.toml")
    if not os.path.exists(path):
        return "Codex: not found, skipped (the session-log watcher still works if you install Codex later)"
    text = open(path).read()
    backup(path)
    m = NOTIFY_LINE.search(text)
    current = m.group(0) if m else ""
    ours = f'notify = ["{NOTIFY}"]\n'
    if install:
        if NOTIFY in current:
            return "Codex: already wired"
        if current:  # Codex allows one notify program; codex-notify forwards to the old one
            prev = re.findall(r'"((?:[^"\\]|\\.)*)"', current)
            save_json(PREV_NOTIFY, prev)
            text = text.replace(current, ours, 1)
        else:
            text = ours + text
        msg = "Codex: notify hook added"
    else:
        if NOTIFY not in current:
            return "Codex: nothing to remove"
        prev = load_json(PREV_NOTIFY, [])
        restored = ("notify = [" + ", ".join(json.dumps(a) for a in prev) + "]\n") if prev else ""
        text = text.replace(current, restored, 1)
        msg = "Codex: notify restored"
    with open(path, "w") as f:
        f.write(text)
    return msg


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "install"
    on = mode == "install"
    for step in (claude, cursor, codex):
        try:
            print("  " + step(on))
        except Exception as e:  # noqa: BLE001
            print(f"  {step.__name__}: skipped ({e})")
